# Regras de cabecalho para Cloudflare Pages (e outros hosts que leem _headers).
# Espelha o netlify.toml: enquanto o site estiver no Netlify, o netlify.toml
# continua valendo; este arquivo entra em acao quando o deploy for pelo
# Cloudflare Pages. Manter os dois em sincronia.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# CSS e JS nao tem hash no nome, entao NUNCA podem ser imutaveis:
# o navegador revalida a cada visita e a CDN responde 304 quando nada mudou.
# Assim uma atualizacao do site aparece na hora para todo mundo.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# Imagens tambem revalidam, porque as capas dos projetos sao trocadas
# mantendo o mesmo nome de arquivo.
/assets/img/*
  Cache-Control: public, max-age=0, must-revalidate

# Video e grande e nao muda. Se precisar trocar, suba com um nome novo
# em vez de sobrescrever este arquivo.
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable
