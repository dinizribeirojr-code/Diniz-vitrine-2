# =============================================================================
# Barbearia Demonstração — variáveis de ambiente de exemplo
# -----------------------------------------------------------------------------
# Copie para .env e preencha ao ligar as integrações reais.
# IMPORTANTE: nada aqui deve ir para o frontend. Estas chaves pertencem ao
# BACKEND que enviará WhatsApp/e-mail. O frontend chama apenas os endpoints
# do seu backend (ver assets/js/config.js -> integrations.*.apiEndpoint).
# NUNCA faça commit do arquivo .env preenchido.
# =============================================================================

# ---- Identidade (opcional; também dá para editar em assets/js/config.js) ----
SHOP_NAME="Barbearia Demonstração"
SHOP_TIMEZONE="America/Sao_Paulo"
SHOP_WHATSAPP="5521999990000"   # placeholder — use o número do cliente

# ---- WhatsApp (ex.: WhatsApp Cloud API) — usado pelo BACKEND -----------------
WHATSAPP_ENABLED=false
WHATSAPP_API_URL="https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages"
WHATSAPP_TOKEN=""                 # token de acesso — NUNCA no frontend
WHATSAPP_PHONE_NUMBER_ID=""

# ---- E-mail (ex.: SMTP ou provedor transacional) — usado pelo BACKEND --------
EMAIL_ENABLED=false
EMAIL_PROVIDER="smtp"             # smtp | sendgrid | resend | ...
EMAIL_API_KEY=""
EMAIL_FROM="contato@barbearianavalha.com.br"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ---- Pagamentos (reservado para o futuro) -----------------------------------
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=""              # stripe | mercadopago | ...
PAYMENTS_SECRET_KEY=""

# ---- Autenticação do painel (ao trocar a demo por backend real) --------------
JWT_SECRET=""
ADMIN_EMAIL="admin@barbearianavalha.com.br"
ADMIN_PASSWORD_HASH=""            # hash (bcrypt/argon2), nunca a senha em texto
